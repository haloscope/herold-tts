# Herold-TTS: CPU-only Docker image (no CUDA required)
# Multi-stage build, optimized for CPU inference
# Non-root user for security hardening

# ============================================================================
# Stage 1: Builder
# ============================================================================
FROM ubuntu:24.04 AS builder

LABEL maintainer="Herold-TTS Project"
LABEL description="Herold-TTS: CPU-only variant (no GPU required)"

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    build-essential \
    git \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create Python virtual environment
RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Upgrade pip, setuptools, wheel
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements and install dependencies (CPU version of torch)
COPY requirements.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# qwen-tts installed separately with --no-deps: its own dependency resolution
# pulls an incompatible torchaudio, breaking the torch/torchaudio pair above.
# Its remaining dependencies (everything except torchaudio) are installed explicitly.
RUN pip install --no-cache-dir --no-deps qwen-tts && \
    pip install --no-cache-dir \
        "transformers==4.57.3" \
        "accelerate==1.12.0" \
        gradio \
        librosa \
        onnxruntime \
        einops \
        sox

# ============================================================================
# Stage 2: Runtime (minimal)
# ============================================================================
FROM ubuntu:24.04

LABEL maintainer="Herold-TTS Project"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r herold && useradd -r -g herold herold

# Copy venv from builder
COPY --from=builder /opt/venv /opt/venv

# Set working directory
WORKDIR /app

# Copy application code
COPY herold/ /app/herold/
COPY resources/ /app/resources/
COPY requirements.txt /app/

# Set environment variables (force CPU mode)
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    TTS_DEVICE=cpu \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    NUMBA_CACHE_DIR=/tmp/numba_cache \
    HF_HOME=/app/.cache/huggingface

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "from herold.render import render_batch; print('OK')" || exit 1

# Change ownership to non-root user
RUN chown -R herold:herold /app

# Switch to non-root user
USER herold

# Default command: bash
CMD ["/bin/bash"]
